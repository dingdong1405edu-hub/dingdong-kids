# =============================================================================
#  DingDong Kids — biến môi trường
#  Chép file này thành .env.local rồi điền giá trị.
# =============================================================================

# Database
DATABASE_URL="postgresql://user:pass@host:5432/dingdong_kids"

# =============================================================================
#  ĐĂNG NHẬP
#  Bật/tắt từng cách trong src/lib/auth-flags.ts (KHÔNG phải ở đây).
#  Hiện tại: Google TẮT · Email + mật khẩu BẬT (để test).
# =============================================================================

# (Tuỳ chọn) Tạo sẵn một tài khoản ADMIN đăng nhập bằng email + mật khẩu khi
# chạy `npm run db:seed`. Chỉ tạo khi đặt CẢ HAI biến — không có mật khẩu mặc
# định trong mã nguồn, vì seed chạy mỗi lần deploy.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Auth — Google (ĐANG TẮT trong src/lib/auth-flags.ts). Bật lại thì hai giá trị
# dưới đây là BẮT BUỘC. Tạo credentials tại
# https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID, loại
# "Web application"). Authorized redirect URI:
#   https://<your-domain>/api/auth/callback/google
#
# !!! NẾU CHỈ *MỘT SỐ* TÀI KHOẢN GOOGLE ĐĂNG NHẬP ĐƯỢC (vd chủ sở hữu vào được
# nhưng người khác báo "Access blocked / app is being tested"): màn hình
# *OAuth consent screen* vẫn ở chế độ "Testing", chỉ cho phép test user trong
# danh sách trắng.
# CÁCH SỬA: Google Cloud Console → APIs & Services → OAuth consent screen →
# "PUBLISH APP" (chuyển Testing → In production). Scope dùng chỉ là
# email/profile/openid (không nhạy cảm) nên KHÔNG cần Google xét duyệt —
# có hiệu lực ngay cho mọi tài khoản Google.
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Groq — chấm bài + sinh câu hỏi + STT dự phòng + trợ lý chat "Ding"
# (https://console.groq.com)
#  - Chấm viết/nói, AI tạo câu hỏi đọc/nghe, tra từ Anh-Việt.
#  - STT dự phòng (Whisper) cho /api/transcribe khi Deepgram lỗi/thiếu key.
#  - Trợ lý chat "Ding" (/api/chat) — dùng chung key này.
GROQ_API_KEY=""

# (Tuỳ chọn) Ghi đè model cho trợ lý chat "Ding". Mặc định: openai/gpt-oss-120b.
GROQ_CHAT_MODEL=""

# (Tuỳ chọn) Danh sách model chấm VIẾT, ưu tiên trái→phải; model lỗi/JSON hỏng
# thì tự rớt sang model kế. Bỏ trống = mặc định gpt-oss-120b → llama → qwen.
# LƯU Ý: bản tiếng Trung để Qwen đứng đầu vì cần model "Chinese-native"; với
# tiếng Anh lý do đó không còn nên gpt-oss-120b lên đầu. NÊN THỬ A/B lại khi có
# dữ liệu bài viết thật của trẻ.
GROQ_WRITING_MODELS=""

# (Tuỳ chọn) Danh sách model cho các luồng JSON khác: chấm NÓI, sinh câu hỏi
# đọc/nghe, giải thích đáp án, tra từ. Cùng quy tắc fallback trái→phải.
GROQ_GRADING_MODELS=""

# Deepgram — Speech-to-Text VÀ Text-to-Speech tiếng Anh
# (https://console.deepgram.com)
DEEPGRAM_API_KEY=""

# --- STT (nghe giọng trẻ → văn bản) ---
#  - Chấm nói trong /api/transcribe.
#  - Admin: "Tạo lời thoại từ audio" ở phần Bài nghe.
# LƯU Ý: độ chính xác trên giọng TRẺ EM thấp hơn giọng người lớn đáng kể — phần
# chấm nói đã được nới ngưỡng và thiên về khuyến khích (xem src/lib/groq.ts).
# (Tuỳ chọn) Ghi đè model / ngôn ngữ. Mặc định: nova-3 + en-US (Anh–Mỹ).
# Dùng "en-GB" nếu muốn giọng Anh–Anh theo chuẩn Cambridge.
DEEPGRAM_STT_MODEL=""
DEEPGRAM_STT_LANGUAGE=""

# --- TTS (sinh giọng đọc) — KHÁC BIỆT LỚN so với bản tiếng Trung ---
# Deepgram KHÔNG có giọng tiếng Trung nên dự án cũ bắt admin tự tải MP3 lên.
# Với TIẾNG ANH thì có (Deepgram Aura) → mọi audio (từ vựng, câu ví dụ, câu hỏi,
# bài nghe) đều sinh tự động. Với trẻ chưa đọc được, đây là điều BẮT BUỘC.
# Kết quả được CACHE trong bảng Upload theo hash(text+voice) nên mỗi câu chỉ tốn
# tiền đúng MỘT lần. Aura tính tiền theo KÝ TỰ — kiểm tra giá trước khi sinh
# hàng loạt cho toàn bộ kho từ vựng.
# (Tuỳ chọn) Ghi đè giọng mặc định. Xem danh sách trong src/lib/tts.ts.
DEEPGRAM_TTS_VOICE=""

# Payment (PayOS - https://my.payos.vn → Kênh thanh toán → "Thông tin xác thực")
# Dán 3 giá trị lấy trong dashboard PayOS vào đây:
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
# Sau khi deploy, vào dashboard PayOS đặt Webhook URL thành:
#   https://<your-domain>/api/payos/webhook
# (Giá & tên gói cấu hình trong src/lib/payment-plans.ts — không phải biến môi trường.)

# Tạo PDF (Tải PDF cho Đọc/Nghe/Viết/Nói + Từ vựng/Ngữ pháp, cả Lộ trình)
#  - Server render HTML → PDF bằng Chromium không giao diện (puppeteer-core).
#  - Production (Railway): nixpacks.toml đã cài sẵn `chromium`; tự dò trên PATH.
#  - Local: tự dò Google Chrome/Chromium/Edge đã cài. Nếu máy cài Chrome ở vị trí
#    lạ, trỏ tay tới file chrome/chromium qua biến dưới (tuỳ chọn).
PUPPETEER_EXECUTABLE_PATH=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
