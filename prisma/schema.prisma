// ===========================================================================
//  DingDong Kids — Tiếng Anh cho trẻ nhỏ
//  Schema Prisma. Cấp độ theo chuẩn Cambridge Young Learners (YLE).
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  ADMIN
}

/// Cấp độ theo chuẩn Cambridge English Qualifications cho trẻ em.
/// Thứ tự tăng dần — dùng `LEVEL_ORDER` trong src/lib/levels.ts để so sánh.
enum EnglishLevel {
  PRE_STARTERS // 4–5 tuổi · làm quen: nghe–nói, nhận mặt chữ, phonics cơ bản
  STARTERS // 6–7 tuổi · Cambridge YLE Starters (Pre-A1)
  MOVERS // 7–9 tuổi · Cambridge YLE Movers (A1)
  FLYERS // 9–11 tuổi · Cambridge YLE Flyers (A2)
  KET // 11–13 tuổi · A2 Key for Schools
  PET // 13–15 tuổi · B1 Preliminary for Schools
}

enum Skill {
  READING
  LISTENING
  WRITING
  SPEAKING
  VOCAB
  GRAMMAR
  PHONICS // ghép vần / âm chữ cái — nền tảng đọc cho trẻ nhỏ
  MOCK // bài thi thử trọn bộ (MockExam)
}

enum QuestionType {
  MCQ
  FILL_BLANK
  TRUE_FALSE
  MATCHING
  SHORT_ANSWER
}

enum WritingTaskType {
  FREE
  GUIDED
  PICTURE_DESCRIPTION
}

enum MaterialCategory {
  GRAMMAR
  VOCABULARY
  PHONICS
  SPELLING
  EXAM_TIPS
  CULTURE
  CONVERSATION
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String?
  image           String?
  emailVerified   DateTime?
  passwordHash    String?
  role            Role         @default(LEARNER)
  xp              Int          @default(0)
  hearts          Int          @default(5)
  heartsUpdatedAt DateTime? // mốc tính hồi tim (regen) — null = đang đầy
  streakDays      Int          @default(0)
  level           EnglishLevel @default(PRE_STARTERS)
  /// Năm sinh của trẻ — dùng để gợi ý cấp độ phù hợp và áp dụng quy định bảo vệ
  /// dữ liệu trẻ em. Null = chưa khai báo.
  birthYear       Int?
  /// Tài khoản phụ huynh quản lý hồ sơ này (nếu có). Cho phép một phụ huynh
  /// theo dõi nhiều hồ sơ con mà không cần đổi schema về sau.
  parentId        String?
  parent          User?        @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children        User[]       @relation("ParentChildren")
  lastActiveAt    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  banned          Boolean      @default(false)

  accounts          Account[]
  sessions          Session[]
  vocabProgress     VocabProgress[]
  vocabReviews      VocabReview[]
  roadmapWordReviews RoadmapWordReview[]
  grammarProgress   GrammarProgress[]
  phonicsProgress   PhonicsProgress[]
  firstWordsProgress FirstWordsProgress[]
  cartoonProgress   CartoonProgress[]
  roadmapProgress   RoadmapProgress[]
  attempts          Attempt[]
  payments          Payment[]
  subscriptions     Subscription[]
  wordReports       WordReport[]
  savedWords        SavedWord[]
  feedbacks         Feedback[]
  auditLogs         AuditLog[]

  @@index([parentId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===================================================================
//  TỪ VỰNG
// ===================================================================

model VocabUnit {
  id        String        @id @default(cuid())
  title     String
  /// Chủ đề ngắn hiển thị trên thẻ, vd "Animals", "My Family".
  theme     String        @default("")
  level     EnglishLevel
  order     Int
  imageUrl  String?
  published Boolean       @default(true)
  lessons   VocabLesson[]

  @@index([level, order])
}

model VocabLesson {
  id        String    @id @default(cuid())
  unitId    String
  unit      VocabUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  order     Int
  title     String    @default("")
  exercises Json
  published Boolean   @default(true)

  progress VocabProgress[]
  words    VocabWord[]

  @@index([unitId, order])
}

/// Một từ vựng trong luồng học từng-từ (xem thẻ + nghe → luyện phát âm →
/// flashcard). `examples` là mảng JSON [{ sentence, meaning, audioUrl? }].
/// ẢNH LÀ BẮT BUỘC với trẻ nhỏ — `imageUrl` phải có trước khi publish.
model VocabWord {
  id        String      @id @default(cuid())
  lessonId  String
  lesson    VocabLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order     Int
  /// Từ tiếng Anh, vd "elephant".
  word      String
  /// Phiên âm quốc tế (IPA), vd "/ˈelɪfənt/". Tuỳ chọn — trẻ nhỏ chưa cần.
  ipa       String      @default("")
  /// Nghĩa tiếng Việt.
  meaning   String
  /// Loại từ: noun | verb | adjective | ... (để trống nếu không cần).
  partOfSpeech String   @default("")
  examples  Json        @default("[]")
  /// Ảnh minh hoạ — kênh truyền đạt CHÍNH cho trẻ chưa đọc thạo.
  imageUrl  String?
  /// Emoji minh hoạ — DỰ PHÒNG khi chưa có ảnh thật. Bé chưa đọc được chữ nên
  /// màn hình luôn phải có hình gì đó; thiếu cả emoji lẫn ảnh thì bé chỉ nhìn
  /// thấy chữ tiếng Anh và không đoán được nghĩa.
  emoji     String      @default("")
  /// Audio phát âm (sinh tự động bằng TTS hoặc admin tải lên).
  audioUrl  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  reviews VocabReview[]
  reports WordReport[]

  @@index([lessonId, order])
}

model VocabProgress {
  id            String   @id @default(cuid())
  userId        String
  lessonId      String
  completed     Boolean  @default(false)
  xpEarned      Int      @default(0)
  /// Vị trí đang học dở (cho nút "Học tiếp"). lastWordIndex = chỉ số từ hiện tại,
  /// lastStep = bước trong từ đó. Reset về 0 khi hoàn thành.
  lastWordIndex Int      @default(0)
  lastStep      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson VocabLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

/// Lặp lại ngắt quãng (SM-2) cho từng từ vựng. Thuật toán ở src/lib/srs.ts.
model VocabReview {
  id             String    @id @default(cuid())
  userId         String
  wordId         String
  repetitions    Int       @default(0)
  intervalDays   Int       @default(0)
  ease           Float     @default(2.5)
  lapses         Int       @default(0)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, dueAt])
}

/// Lặp lại ngắt quãng cho từ vựng phần LỘ TRÌNH. Khoá theo `(userId, word)` vì
/// từ vựng lộ trình nằm trong RoadmapSection.content (JSON), không có bản ghi
/// VocabWord để tham chiếu khoá ngoại. Lưu kèm ảnh chụp nội dung tại thời điểm ôn.
model RoadmapWordReview {
  id             String    @id @default(cuid())
  userId         String
  word           String
  ipa            String    @default("")
  meaning        String    @default("")
  examples       Json      @default("[]")
  imageUrl       String?
  /// Emoji minh hoạ — chụp lại cùng lúc với ảnh, để màn ôn tập luôn có hình
  /// kể cả khi chưa có ảnh thật.
  emoji          String    @default("")
  audioUrl       String?
  repetitions    Int       @default(0)
  intervalDays   Int       @default(0)
  ease           Float     @default(2.5)
  lapses         Int       @default(0)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
  @@index([userId, dueAt])
}

// ===================================================================
//  NGỮ PHÁP
// ===================================================================

model GrammarUnit {
  id        String          @id @default(cuid())
  title     String
  theme     String          @default("")
  level     EnglishLevel
  order     Int
  imageUrl  String?
  published Boolean         @default(true)
  lessons   GrammarLesson[]

  @@index([level, order])
}

model GrammarLesson {
  id        String      @id @default(cuid())
  unitId    String
  unit      GrammarUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  order     Int
  title     String      @default("")
  exercises Json
  published Boolean     @default(true)

  progress GrammarProgress[]

  @@index([unitId, order])
}

model GrammarProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  xpEarned  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ===================================================================
//  PHONICS (ghép vần) — nền tảng đọc cho trẻ nhỏ
// ===================================================================

/// Tiến độ học PHONICS. `lessonId` là id tĩnh của bài học định nghĩa trong
/// src/lib/phonics-lessons.ts (nội dung cố định trong code, chỉ tiến độ lưu DB).
model PhonicsProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String // id bài học tĩnh (vd "phonics-short-a")
  completed Boolean  @default(false)
  bestScore Int      @default(0) // % đúng cao nhất
  xpEarned  Int      @default(0)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

// ===================================================================
//  BÉ TẬP NÓI (First Words) — cấp ĐỨNG TRƯỚC Pre-Starters
// ===================================================================

/// Tiến độ cấp "Bé Tập Nói" — dành cho bé 3–5 tuổi CHƯA BIẾT CHỮ: chỉ nhìn
/// hình, nghe tiếng và nhắc lại từng từ; phát âm do AI (Groq) chấm.
///
/// `unitId` là id TĨNH của chủ đề định nghĩa trong src/lib/first-words.ts —
/// cùng khuôn với PhonicsProgress: nội dung cố định trong code, chỉ tiến độ
/// của bé nằm ở DB. Nhờ vậy thêm/sửa chủ đề không cần đụng schema hay seed.
model FirstWordsProgress {
  id        String   @id @default(cuid())
  userId    String
  unitId    String // id chủ đề tĩnh (vd "animals")
  completed Boolean  @default(false)
  /// Sao cao nhất của TỪNG từ, cùng thứ tự với `words` trong src/lib/first-words.ts
  /// — vd `[3,2,3,1,0,0,0,0]`. Đây là NGUỒN SỰ THẬT; `bestStars`/`wordsSaid` chỉ
  /// là số tổng tính sẵn để trang danh sách khỏi phải cộng lại.
  /// Nhờ dữ liệu theo từng từ mà làm được báo cáo cho bố mẹ ("bé vướng từ nào")
  /// và dựng được bài ôn riêng cho những từ bé chưa nói tốt.
  wordStars Json     @default("[]")
  /// Tổng sao cao nhất từng đạt ở chủ đề (mỗi từ tối đa 3 sao).
  bestStars Int      @default(0)
  /// Số từ bé đã nói được (≥ 2 sao) trong lần tốt nhất — để hiện "6/8 từ".
  wordsSaid Int      @default(0)
  xpEarned  Int      @default(0)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId])
}

// ===================================================================
//  TRẢI NGHIỆM — XEM HOẠT HÌNH (nói theo phim / shadowing)
// ===================================================================

/// Tiến độ khu "Xem hoạt hình": phim chạy đúng MỘT CÂU rồi dừng, bé nhắc lại
/// câu đó, máy nghe và chấm sao.
///
/// `cartoonId` là id TĨNH của phim định nghĩa trong src/lib/cartoon-data —
/// cùng khuôn với FirstWordsProgress/PhonicsProgress: nội dung (video + mốc
/// thời gian) cố định trong code, chỉ tiến độ nằm ở DB. Nhờ vậy thêm phim mới
/// không phải đụng schema hay seed.
model CartoonProgress {
  id        String  @id @default(cuid())
  userId    String
  cartoonId String // id phim tĩnh (vd "peppa-muddy-puddles")
  completed Boolean @default(false)
  /// Sao cao nhất của TỪNG câu, cùng thứ tự với `lines` của phim — vd
  /// `[3,2,3,1,0]`. NGUỒN SỰ THẬT; `bestStars`/`linesSaid` chỉ là số tổng tính
  /// sẵn để trang danh sách khỏi cộng lại. Dữ liệu theo từng câu cho phép chỉ
  /// đúng câu bé còn vướng cho bố mẹ xem.
  lineStars Json    @default("[]")
  /// Tổng sao cao nhất từng đạt ở phim (mỗi câu tối đa 3 sao).
  bestStars Int     @default(0)
  /// Số câu bé nói được (≥ 2 sao) trong lần tốt nhất — để hiện "8/12 câu".
  linesSaid Int     @default(0)
  xpEarned  Int     @default(0)
  attempts  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cartoonId])
  @@index([userId])
}

// ===================================================================
//  ĐỌC · NGHE
// ===================================================================

model ReadingTest {
  id       String       @id @default(cuid())
  title    String
  level    EnglishLevel
  passage  String       @db.Text
  /// Bản dịch tiếng Việt TOÀN BỘ đoạn văn — hiện ở phần "chữa bài".
  passageTranslation String? @db.Text
  /// Phân tích TỪNG CÂU: Json mảng [{ en, vi, note }].
  passageAnalysis    Json?
  imageUrl  String?
  /// Audio đọc mẫu cả đoạn (TTS) — trẻ vừa nghe vừa nhìn chữ.
  audioUrl  String?
  timeLimit Int
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  questions Question[]

  @@index([level, order])
}

model ListeningTest {
  id         String       @id @default(cuid())
  title      String
  level      EnglishLevel
  audioUrl   String
  transcript String?      @db.Text
  /// Bản dịch + giải thích toàn bộ lời thoại (tiếng Việt) — hiện khi chữa bài.
  transcriptExplanation String? @db.Text
  imageUrl   String?
  timeLimit  Int      @default(300)
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  questions Question[]

  @@index([level, order])
}

model Question {
  id     String       @id @default(cuid())
  type   QuestionType
  prompt String       @db.Text
  /// Bản dịch tiếng Việt của câu hỏi — hiện khi chữa bài.
  promptTranslation String? @db.Text
  /// Ảnh minh hoạ cho riêng câu hỏi này (trẻ nhỏ chọn đáp án bằng hình).
  imageUrl        String?
  /// Audio đọc câu hỏi (TTS) — trẻ chưa đọc thạo vẫn làm được bài.
  audioUrl        String?
  options         Json?
  correctAnswer   Json
  explanation     String? @db.Text
  /// Câu trích trong bài chứng minh đáp án — "chỉ cho trẻ đáp án lấy ở đâu".
  supportingQuote String? @db.Text
  quoteTranslation String? @db.Text
  order           Int     @default(0)

  readingId   String?
  listeningId String?
  examPartId  String?

  reading   ReadingTest?   @relation(fields: [readingId], references: [id], onDelete: Cascade)
  listening ListeningTest? @relation(fields: [listeningId], references: [id], onDelete: Cascade)
  examPart  MockExamPart?  @relation(fields: [examPartId], references: [id], onDelete: Cascade)

  @@index([examPartId, order])
}

// ===================================================================
//  THI THỬ — đề Cambridge YLE trọn bộ.
//  MockExam (1 đề/cấp) → MockExamSection (Listening / Reading & Writing /
//  Speaking) → MockExamPart (Part 1...) → Question.
// ===================================================================

model MockExam {
  id          String       @id @default(cuid())
  title       String // "Đề thi thử Starters — Đề 1"
  level       EnglishLevel
  description String?      @db.Text
  totalTime   Int? // tổng thời gian (giây); null = cộng dồn từ các phần
  order       Int          @default(0)
  published   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  sections MockExamSection[]

  @@index([level, order])
}

model MockExamSection {
  id           String   @id @default(cuid())
  examId       String
  exam         MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  skill        Skill // LISTENING | READING | WRITING | SPEAKING
  order        Int      @default(0)
  title        String   @default("") // "Listening" (suy từ skill nếu trống)
  instructions String?  @db.Text

  parts MockExamPart[]

  @@index([examId, order])
}

model MockExamPart {
  id              String          @id @default(cuid())
  sectionId       String
  section         MockExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order           Int             @default(0)
  title           String          @default("") // "Part 1"
  instructions    String?         @db.Text // hướng dẫn / ví dụ mẫu
  imageUrl        String? // ảnh dùng chung cho tiểu phần (câu hỏi nhìn hình)
  // Đọc hiểu:
  passage         String?         @db.Text
  // Nghe hiểu:
  audioUrl        String?
  transcript      String?         @db.Text
  // Viết tự luận: nếu set => tiểu phần là 1 ô viết, chấm bằng AI
  writingPrompt   String?         @db.Text
  writingMinWords Int?

  questions Question[]

  @@index([sectionId, order])
}

// ===================================================================
//  VIẾT · NÓI
// ===================================================================

model WritingTask {
  id       String          @id @default(cuid())
  taskType WritingTaskType
  prompt   String          @db.Text
  /// Dàn ý gợi ý (mỗi ý một dòng) — ẩn mặc định, trẻ bấm "Gợi ý" mới hiện.
  outline  String?         @db.Text
  imageUrl String?
  /// Số TỪ tối thiểu (tiếng Anh đếm từ, không đếm ký tự).
  minWords  Int
  timeLimit Int
  level     EnglishLevel
  order     Int          @default(0)
  published Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  @@index([level, order])
}

/// Bộ bài luyện nói theo format Cambridge YLE Speaking:
/// part1 = nhắc lại câu · part2 = đọc to đoạn văn · part3 = trả lời câu hỏi.
model SpeakingSet {
  id             String       @id @default(cuid())
  title          String       @default("")
  level          EnglishLevel
  imageUrl       String?
  part1Sentences Json
  part2Passage   Json
  part3Questions Json
  order          Int      @default(0)
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([level, order])
}

/// Bài "Nói theo chủ đề": giám khảo đặt MỘT câu hỏi mở, trẻ ghi âm trả lời
/// thành một đoạn → Deepgram chuyển thành lời thoại → AI chấm chi tiết.
/// `hints` = JSON mảng [{ text, vi? }] gợi ý từ/cụm nên dùng.
model SpeakingTopic {
  id             String       @id @default(cuid())
  title          String       @default("")
  level          EnglishLevel
  topic          String       @default("") // nhãn chủ đề ngắn, vd "My Pets"
  question       String       @db.Text // câu giám khảo hỏi (tiếng Anh)
  questionVi     String?      @db.Text // dịch tiếng Việt
  /// Gợi ý dàn ý (mỗi ý một dòng).
  outline        String?      @db.Text
  audioUrl       String? // MP3 câu hỏi (TTS hoặc admin tải lên)
  transcript     String?      @db.Text
  hints          Json         @default("[]") // [{ text, vi? }]
  sampleAnswer   String?      @db.Text
  minWords       Int          @default(0)
  prepSeconds    Int          @default(0)
  imageUrl       String?
  order          Int      @default(0)
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([level, order])
}

/// Tài liệu học tập. `content` là mảng block có cấu trúc:
///   heading | paragraph | list | example | vocab | note
model Material {
  id          String           @id @default(cuid())
  title       String
  category    MaterialCategory
  level       EnglishLevel
  summary     String           @db.Text
  imageUrl    String?
  content     Json
  tags        Json?
  readMinutes Int              @default(5)
  order       Int              @default(0)
  published   Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@index([level, category, order])
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  skill       Skill
  refId       String
  rawAnswer   Json
  score       Float?
  feedback    Json?
  durationSec Int?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, skill])
  @@index([userId, createdAt])
}

// ===================================================================
//  HỌC THEO LỘ TRÌNH (Duolingo-style)
//  Course (1 per level) → RoadmapLesson → RoadmapSection (7 kỹ năng)
// ===================================================================

/// Một khóa học = một cấp độ. Mỗi cấp có một khóa duy nhất.
model Course {
  id          String       @id @default(cuid())
  level       EnglishLevel @unique
  title       String
  subtitle    String       @default("")
  description String?      @db.Text
  order       Int
  imageUrl    String?
  published   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  lessons  RoadmapLesson[]
  chapters RoadmapChapter[]

  @@index([order])
}

/// Chương của một khóa — gom các bài thành nhóm (banner trên map).
/// Đây là "nguồn sự thật"; mỗi bài trỏ về chương qua `chapterId`.
/// `RoadmapLesson.chapter` / `chapterOrder` là BẢN SAO (cache) đồng bộ từ chương.
model RoadmapChapter {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order     Int
  title     String
  subtitle  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  lessons RoadmapLesson[]

  @@unique([courseId, order])
  @@index([courseId, order])
}

/// Một bài trong lộ trình: một chủ đề, gom đủ các kỹ năng.
model RoadmapLesson {
  id           String          @id @default(cuid())
  courseId     String
  course       Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order        Int
  topic        String
  /// Nhãn phụ tiếng Việt của chủ đề, vd "Động vật".
  topicVi      String          @default("")
  description  String?         @db.Text
  icon         String?
  chapterId    String?
  chapterRef   RoadmapChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  chapter      String?
  chapterOrder Int             @default(1)
  xpReward     Int             @default(20)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt

  sections RoadmapSection[]
  progress RoadmapProgress[]

  @@unique([courseId, order])
  @@index([courseId, chapterOrder, order])
  @@index([chapterId])
}

/// Một kỹ năng trong bài. `published = false` => "Sắp có".
model RoadmapSection {
  id        String        @id @default(cuid())
  lessonId  String
  lesson    RoadmapLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  skill     Skill
  order     Int           @default(0)
  title     String        @default("")
  content   Json?
  refId     String?
  published Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  @@unique([lessonId, skill])
  @@index([lessonId, order])
}

/// Tiến độ theo từng bài lộ trình. `skillsDone` = mảng tên Skill đã hoàn thành.
model RoadmapProgress {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      RoadmapLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean       @default(false)
  skillsDone  Json          @default("[]")
  score       Float?
  xpEarned    Int           @default(0)
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
}

// ===================================================================
//  THANH TOÁN & QUYỀN LỢI
// ===================================================================

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  FAILED
}

/// Đơn thanh toán qua PayOS. `orderCode` sinh từ timestamp nên dùng BigInt.
/// Giá/tên gói cấu hình ở src/lib/payment-plans.ts.
model Payment {
  id            String        @id @default(cuid())
  orderCode     BigInt        @unique
  userId        String?
  amount        Int
  description   String
  planId        String?
  planName      String
  status        PaymentStatus @default(PENDING)
  buyerName     String?
  buyerEmail    String?
  checkoutUrl   String?       @db.Text
  paymentLinkId String?
  reference     String?
  paidAt        DateTime?
  rawWebhook    Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

enum SubscriptionType {
  FREESTYLE // Gói tự do: mọi tính năng ngoài lộ trình + tim không giới hạn
  ROADMAP // Gói lộ trình theo cấp độ
}

/// Quyền lợi đã mua. Một lần mua có thể tạo nhiều Subscription.
/// Quyền CÒN HẠN khi expiresAt > now. Cách suy ra quyền: src/lib/entitlements.ts.
model Subscription {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SubscriptionType
  level     EnglishLevel? // chỉ dùng cho ROADMAP
  startedAt DateTime         @default(now())
  expiresAt DateTime
  paymentId String? // Payment.id đã kích hoạt quyền này (idempotent)
  createdAt DateTime         @default(now())

  @@index([userId, expiresAt])
  @@index([paymentId])
}

// ===================================================================
//  PHẢN HỒI · SỔ TỪ · TỆP · NHẬT KÝ
// ===================================================================

enum WordReportKind {
  ERROR // Báo lỗi: từ/nghĩa/phát âm bị sai
  COMMENT // Bình luận / góp ý
}

enum WordReportStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Phản ánh / bình luận của học viên trên một từ vựng. Chỉ khi `APPROVED` thì
/// bình luận mới hiển thị công khai (kiểm duyệt — bắt buộc với nội dung trẻ em).
model WordReport {
  id        String           @id @default(cuid())
  userId    String
  wordId    String
  kind      WordReportKind   @default(COMMENT)
  content   String           @db.Text
  status    WordReportStatus @default(PENDING)
  adminNote String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, status])
  @@index([status, createdAt])
}

/// "Sổ từ" — từ học viên lưu lại khi tra cứu. Snapshot nghĩa tại thời điểm lưu.
model SavedWord {
  id        String   @id @default(cuid())
  userId    String
  word      String
  ipa       String   @default("")
  meaning   String   @db.Text
  level     String?
  source    String? // ngữ cảnh: "reading:<id>" / "listening:<id>" ...
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
  @@index([userId, createdAt])
}

enum FeedbackCategory {
  SUGGESTION
  BUG
  QUESTION
  CONTENT
  OTHER
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  RESOLVED
}

/// Liên hệ & góp ý (gửi từ khu vực học nên luôn gắn với tài khoản đã đăng nhập).
model Feedback {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     FeedbackCategory @default(SUGGESTION)
  subject      String?
  message      String           @db.Text
  contactName  String?
  contactEmail String?
  status       FeedbackStatus   @default(NEW)
  adminNote    String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

/// Tệp do admin tải lên / sinh ra (ảnh minh hoạ, audio bài nghe, MP3 từ TTS).
/// Lưu THẲNG trong Postgres vì filesystem Railway là ephemeral.
/// Phục vụ qua `/api/files/[id]`; URL lưu ở imageUrl/audioUrl là `/api/files/<id>`.
model Upload {
  id        String   @id @default(cuid())
  mime      String // VD: "image/webp", "audio/mpeg"
  ext       String // png/jpg/webp/mp3/wav/...
  size      Int
  kind      String   @default("image") // "image" | "audio"
  data      Bytes
  /// Khoá cache cho audio sinh bằng TTS: hash của (văn bản + giọng đọc).
  /// Trùng khoá => dùng lại tệp cũ, KHÔNG gọi TTS lần nữa (tiết kiệm chi phí).
  ttsKey    String?  @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// Nhật ký thao tác của quản trị viên. `actorEmail`/`actorName` là SNAPSHOT.
/// `before`/`after` lưu nội dung TRƯỚC/SAU mỗi thay đổi để xem lại / khôi phục.
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actorEmail String
  actorName  String?
  action     AuditAction
  entity     String
  entityId   String?
  summary    String      @db.Text
  before     Json?
  after      Json?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entity, createdAt])
  @@index([createdAt])
}
